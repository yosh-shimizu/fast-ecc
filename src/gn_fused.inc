                    pi0 += j0 * ii;  pi1 += j1 * ii;  pi2 += j2 * ii;  pi3 += j3 * ii;
                    pt0 += j0 * tt;  pt1 += j1 * tt;  pt2 += j2 * tt;  pt3 += j3 * tt;
