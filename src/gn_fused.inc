            t_pi0 += pi0;  t_pi1 += pi1;  t_pi2 += pi2;  t_pi3 += pi3;  t_pt0 += pt0;  t_pt1 += pt1;  t_pt2 += pt2;  t_pt3 += pt3;  t_pj0 += pj0;  t_pj1 += pj1;  t_pj2 += pj2;  t_pj3 += pj3;
