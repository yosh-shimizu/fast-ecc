// ---------------------------------------------------------------------------
// Fused Gauss-Newton step.
//
// The upstream path materialises a hs x (ws*P) jacobian and then reads it back
// P^2 times for the Gram matrix plus 2*P times for each of the three vector
// projections -- none of it parallelised (Mat::dot has no parallel_for_).
//
// Every ECC jacobian is a column subset of an outer product.  Writing u for a
// short vector of gradient-like quantities and w for the coordinate vector:
//
//   translation  u = (gx, gy)                        w = (1)        2 = 2x1
//   euclidean    u = (gx*hatX + gy*hatY, gx, gy)     w = (1)        3 = 3x1
//   affine       u = (gx, gy)                        w = (x, y, 1)  6 = 2x3
//   homography   u = (a, b, e)                       w = (x, y, 1)  8 = 3x3-1
//
// where, for homography, den = h6*x + h7*y + 1, a = gx/den, b = gy/den,
// hatX = -x'/den, hatY = -y'/den and e = hatX*a + hatY*b.  Column (e,1) is the
// one the 8-parameter homography does not carry.
//
// The n-th row of G is u_n (x) w_n restricted to those columns, so
//
//   H_pq = sum_n (u_{k(p)} u_{k(q)}) (w_{l(p)} w_{l(q)})
//
// and the whole Gram matrix falls out of the K(K+1)/2 x L(L+1)/2 table of sums
// of u_k u_k' w_l w_l'.  One pass over gx, gy, i-bar and t-bar fills that table
// and both projections; x and y come from the loop indices, so Xgrid/Ygrid are
// never read.  float accumulators inside a row, promoted to double at the row
// end.
//
// The kernels below are written out with NAMED scalar accumulators rather than
// arrays: with `float m[KK][LL]` MSVC keeps the table in memory and every pixel
// pays indexed loads and stores (measured 0.67x against 1.11x for affine at
// window 256, single thread).  The bodies are generated by
// tools/gen_gn_kernels.py, which CI checks against this file.
//
// The pass reads the RAW planes -- the warped image, the blurred template, the
// two finite-difference gradients of the warped image and the warped mask --
// and does the masking, the A^-T recombination of the gradient and the
// zero-mean centring per pixel.  The means come from maskedStats() in
// fast_ecc.cpp, one cheap pass ahead of this one.  Between filter2D and here
// nothing is written to memory any more: the three masked setTo, the two
// meanStdDev, the two masked subtract, the two countNonZero, the dot product
// and the two addWeighted of the previous layout are gone, and with them the
// three planes they produced.
//
// Every kernel has a twin, GN<Name>L, with one more column: the laplacian of
// the warped image (scaled by the pre-filter's sigma).  It is the nuisance
// direction for the isotropic second-order term of a misalignment residual
// and for the bilinear interpolation error, both of which have that shape;
// with it in the system the first step from 1 px lands at 0.07 px instead of
// 0.18, the basin widens and the fixed point on a real image moves toward
// the truth (see README.md).  sigma itself is not estimated: the objective
// has no minimum in it.
//
// The kernels also sum the jacobian columns (VJ), which lets the single-pass
// iteration in fast_ecc.cpp centre on the previous iteration's means and
// correct exactly afterwards, and rows() takes the row index of the first row
// of the planes it is given (`base`), so that it can run on stripe buffers as
// well as on full planes.
//
// Vector path.  Under FASTECC_SIMD_GN (set by fast_ecc.cpp when OpenCV's
// universal intrinsics are available in their function form, OpenCV >= 4.7,
// and neither FASTECC_NO_SIMD nor FASTECC_NO_SIMD_GN is defined) each row is
// first run VL pixels at a time with one partial sum per lane for every
// live accumulator, reduced into the scalar row accumulators before the
// scalar loop takes the tail.  The mask is a bitwise AND on the gradient
// inputs: everything downstream of a zeroed gradient is zero, so a masked
// lane contributes nothing.  MSVC will not vectorise these reductions on
// its own under /fp:precise; the lanes are the same reassociation the
// scalar kernels already make (float within a row, double at row end),
// one level down, and four shorter chains lose less than one long one.
//
// All four are here.  translation and euclidean gain least: with w = (1) their
// Hessians have only 3 and 6 entries, so this stage is a small share of their
// work to begin with.


#ifndef FASTECC_SIMD_GN
#define FASTECC_SIMD_GN 0
#endif

// ---- translation: K=2 L=1 P=2, 3 Gram sums (3 live) + 6 projection sums ----
struct GNTranslation {
    enum { P = 2 };
    float muI, muT;             // masked means of warped image and template
    double H[3], VI[2], VT[2], VJ[2];
    GNTranslation() { std::fill(H, H + 3, 0.0); std::fill(VI, VI + 2, 0.0); std::fill(VT, VT + 2, 0.0); std::fill(VJ, VJ + 2, 0.0); }
    void add(const GNTranslation& o) {
        for (int i = 0; i < 3; ++i) H[i] += o.H[i];
        for (int i = 0; i < 2; ++i) { VI[i] += o.VI[i]; VT[i] += o.VT[i]; VJ[i] += o.VJ[i]; }
    }

    void rows(const Mat& gx, const Mat& gy, const Mat& im, const Mat& tm,
              const Mat& lp, const Mat& mask, int y0, int y1, int base) {
        const int w = gx.cols;
        (void)lp;
        double t_m0_0 = 0, t_m1_0 = 0, t_m2_0 = 0;
        double t_pi0 = 0, t_pi1 = 0, t_pt0 = 0, t_pt1 = 0, t_pj0 = 0, t_pj1 = 0;
#if FASTECC_SIMD_GN
        const int VL = VTraits<v_float32>::vlanes();
        float CV_DECL_ALIGNED(64) lane[VTraits<v_float32>::max_nlanes];
        for (int k = 0; k < VL; ++k) lane[k] = (float)k;
        const v_float32 vlane = vx_load_aligned(lane), vVL = vx_setall_f32((float)VL);
        const v_float32 vmuI = vx_setall_f32(muI), vmuT = vx_setall_f32(muT);
        const v_int32 vzi = vx_setzero_s32();
#endif

        for (int y = y0; y < y1; ++y) {
            const float* pgx = gx.ptr<float>(y - base);
            const float* pgy = gy.ptr<float>(y - base);
            const float* pim = im.ptr<float>(y - base);
            const float* ptm = tm.ptr<float>(y);
            const uchar* pmk = mask.ptr<uchar>(y - base);
            const float fy = (float)y;
            float m0_0 = 0, m1_0 = 0, m2_0 = 0;
            float pi0 = 0, pi1 = 0, pt0 = 0, pt1 = 0, pj0 = 0, pj1 = 0;
            int x = 0;
#if FASTECC_SIMD_GN
            {
                v_float32 vm0_0 = vx_setzero_f32(), vm1_0 = vx_setzero_f32(), vm2_0 = vx_setzero_f32();
                v_float32 vpi0 = vx_setzero_f32(), vpi1 = vx_setzero_f32(), vpt0 = vx_setzero_f32(), vpt1 = vx_setzero_f32(), vpj0 = vx_setzero_f32(), vpj1 = vx_setzero_f32();
                v_float32 vx = vlane;
                for (; x + VL <= w; x += VL) {
                    const v_float32 mf = v_reinterpret_as_f32(v_ne(v_reinterpret_as_s32(vx_load_expand_q(pmk + x)), vzi));
                    const v_float32 gxv = v_and(vx_load(pgx + x), mf), gyv = v_and(vx_load(pgy + x), mf);
                    const v_float32 a = gxv, b = gyv;
                    const v_float32 uu0 = v_mul(a, a), uu1 = v_mul(a, b), uu2 = v_mul(b, b);
                    vm0_0 = v_add(vm0_0, uu0);
                    vm1_0 = v_add(vm1_0, uu1);
                    vm2_0 = v_add(vm2_0, uu2);
                    const v_float32 ii = v_sub(vx_load(pim + x), vmuI), tt = v_sub(vx_load(ptm + x), vmuT);
                    const v_float32 j0 = a;
                    const v_float32 j1 = b;
                    vpi0 = v_fma(j0, ii, vpi0);  vpi1 = v_fma(j1, ii, vpi1);
                    vpt0 = v_fma(j0, tt, vpt0);  vpt1 = v_fma(j1, tt, vpt1);
                    vpj0 = v_add(vpj0, j0);  vpj1 = v_add(vpj1, j1);
                    vx = v_add(vx, vVL);
                }
                m0_0 = v_reduce_sum(vm0_0);  m1_0 = v_reduce_sum(vm1_0);  m2_0 = v_reduce_sum(vm2_0);
                pi0 = v_reduce_sum(vpi0);  pi1 = v_reduce_sum(vpi1);  pt0 = v_reduce_sum(vpt0);  pt1 = v_reduce_sum(vpt1);  pj0 = v_reduce_sum(vpj0);  pj1 = v_reduce_sum(vpj1);
            }
#endif

            for (; x < w; ++x) {
                if (pmk[x] != 0) {
                    const float a = pgx[x], b = pgy[x];
                    const float uu0 = a * a, uu1 = a * b, uu2 = b * b;
                    m0_0 += uu0;
                    m1_0 += uu1;
                    m2_0 += uu2;
                    const float ii = pim[x] - muI, tt = ptm[x] - muT;
                    const float j0 = a;
                    const float j1 = b;
                    pi0 += j0 * ii;  pi1 += j1 * ii;
                    pt0 += j0 * tt;  pt1 += j1 * tt;
                    pj0 += j0;  pj1 += j1;
                }
            }

            t_m0_0 += m0_0;  t_m1_0 += m1_0;  t_m2_0 += m2_0;
            t_pi0 += pi0;  t_pi1 += pi1;  t_pt0 += pt0;  t_pt1 += pt1;  t_pj0 += pj0;  t_pj1 += pj1;
        }

        int n = 0;
        H[n++] += t_m0_0;  H[n++] += t_m1_0;
        H[n++] += t_m2_0;
        VI[0] += t_pi0;  VI[1] += t_pi1;
        VT[0] += t_pt0;  VT[1] += t_pt1;
        VJ[0] += t_pj0;  VJ[1] += t_pj1;
    }
};

// ---- translationl: K=3 L=1 P=3, 6 Gram sums (6 live) + 9 projection sums ----
struct GNTranslationL {
    enum { P = 3 };
    float muI, muT;             // masked means of warped image and template
    float lsc;                  // scale of the laplacian column (the pre-filter sigma)
    double H[6], VI[3], VT[3], VJ[3];
    GNTranslationL() { std::fill(H, H + 6, 0.0); std::fill(VI, VI + 3, 0.0); std::fill(VT, VT + 3, 0.0); std::fill(VJ, VJ + 3, 0.0); }
    void add(const GNTranslationL& o) {
        for (int i = 0; i < 6; ++i) H[i] += o.H[i];
        for (int i = 0; i < 3; ++i) { VI[i] += o.VI[i]; VT[i] += o.VT[i]; VJ[i] += o.VJ[i]; }
    }

    void rows(const Mat& gx, const Mat& gy, const Mat& im, const Mat& tm,
              const Mat& lp, const Mat& mask, int y0, int y1, int base) {
        const int w = gx.cols;
        double t_m0_0 = 0, t_m1_0 = 0, t_m2_0 = 0, t_m3_0 = 0, t_m4_0 = 0, t_m5_0 = 0;
        double t_pi0 = 0, t_pi1 = 0, t_pi2 = 0, t_pt0 = 0, t_pt1 = 0, t_pt2 = 0, t_pj0 = 0, t_pj1 = 0, t_pj2 = 0;
#if FASTECC_SIMD_GN
        const int VL = VTraits<v_float32>::vlanes();
        float CV_DECL_ALIGNED(64) lane[VTraits<v_float32>::max_nlanes];
        for (int k = 0; k < VL; ++k) lane[k] = (float)k;
        const v_float32 vlane = vx_load_aligned(lane), vVL = vx_setall_f32((float)VL);
        const v_float32 vmuI = vx_setall_f32(muI), vmuT = vx_setall_f32(muT);
        const v_int32 vzi = vx_setzero_s32();
        const v_float32 vlsc = vx_setall_f32(lsc);
#endif

        for (int y = y0; y < y1; ++y) {
            const float* pgx = gx.ptr<float>(y - base);
            const float* pgy = gy.ptr<float>(y - base);
            const float* pim = im.ptr<float>(y - base);
            const float* ptm = tm.ptr<float>(y);
            const float* pl = lp.ptr<float>(y - base);
            const uchar* pmk = mask.ptr<uchar>(y - base);
            const float fy = (float)y;
            float m0_0 = 0, m1_0 = 0, m2_0 = 0, m3_0 = 0, m4_0 = 0, m5_0 = 0;
            float pi0 = 0, pi1 = 0, pi2 = 0, pt0 = 0, pt1 = 0, pt2 = 0, pj0 = 0, pj1 = 0, pj2 = 0;
            int x = 0;
#if FASTECC_SIMD_GN
            {
                v_float32 vm0_0 = vx_setzero_f32(), vm1_0 = vx_setzero_f32(), vm2_0 = vx_setzero_f32(), vm3_0 = vx_setzero_f32(), vm4_0 = vx_setzero_f32(), vm5_0 = vx_setzero_f32();
                v_float32 vpi0 = vx_setzero_f32(), vpi1 = vx_setzero_f32(), vpi2 = vx_setzero_f32(), vpt0 = vx_setzero_f32(), vpt1 = vx_setzero_f32(), vpt2 = vx_setzero_f32();
                v_float32 vpj0 = vx_setzero_f32(), vpj1 = vx_setzero_f32(), vpj2 = vx_setzero_f32();
                v_float32 vx = vlane;
                for (; x + VL <= w; x += VL) {
                    const v_float32 mf = v_reinterpret_as_f32(v_ne(v_reinterpret_as_s32(vx_load_expand_q(pmk + x)), vzi));
                    const v_float32 gxv = v_and(vx_load(pgx + x), mf), gyv = v_and(vx_load(pgy + x), mf);
                    const v_float32 lv = v_and(vx_load(pl + x), mf);
                    const v_float32 a = gxv, b = gyv;
                    const v_float32 l = v_mul(vlsc, lv);
                    const v_float32 uu0 = v_mul(a, a), uu1 = v_mul(a, b), uu2 = v_mul(a, l), uu3 = v_mul(b, b), uu4 = v_mul(b, l), uu5 = v_mul(l, l);
                    vm0_0 = v_add(vm0_0, uu0);
                    vm1_0 = v_add(vm1_0, uu1);
                    vm2_0 = v_add(vm2_0, uu2);
                    vm3_0 = v_add(vm3_0, uu3);
                    vm4_0 = v_add(vm4_0, uu4);
                    vm5_0 = v_add(vm5_0, uu5);
                    const v_float32 ii = v_sub(vx_load(pim + x), vmuI), tt = v_sub(vx_load(ptm + x), vmuT);
                    const v_float32 j0 = a;
                    const v_float32 j1 = b;
                    const v_float32 j2 = l;
                    vpi0 = v_fma(j0, ii, vpi0);  vpi1 = v_fma(j1, ii, vpi1);  vpi2 = v_fma(j2, ii, vpi2);
                    vpt0 = v_fma(j0, tt, vpt0);  vpt1 = v_fma(j1, tt, vpt1);  vpt2 = v_fma(j2, tt, vpt2);
                    vpj0 = v_add(vpj0, j0);  vpj1 = v_add(vpj1, j1);  vpj2 = v_add(vpj2, j2);
                    vx = v_add(vx, vVL);
                }
                m0_0 = v_reduce_sum(vm0_0);  m1_0 = v_reduce_sum(vm1_0);  m2_0 = v_reduce_sum(vm2_0);  m3_0 = v_reduce_sum(vm3_0);  m4_0 = v_reduce_sum(vm4_0);  m5_0 = v_reduce_sum(vm5_0);
                pi0 = v_reduce_sum(vpi0);  pi1 = v_reduce_sum(vpi1);  pi2 = v_reduce_sum(vpi2);  pt0 = v_reduce_sum(vpt0);  pt1 = v_reduce_sum(vpt1);  pt2 = v_reduce_sum(vpt2);
                pj0 = v_reduce_sum(vpj0);  pj1 = v_reduce_sum(vpj1);  pj2 = v_reduce_sum(vpj2);
            }
#endif

            for (; x < w; ++x) {
                if (pmk[x] != 0) {
                    const float a = pgx[x], b = pgy[x];
                    const float l = lsc * pl[x];
                    const float uu0 = a * a, uu1 = a * b, uu2 = a * l, uu3 = b * b, uu4 = b * l, uu5 = l * l;
                    m0_0 += uu0;
                    m1_0 += uu1;
                    m2_0 += uu2;
                    m3_0 += uu3;
                    m4_0 += uu4;
                    m5_0 += uu5;
                    const float ii = pim[x] - muI, tt = ptm[x] - muT;
                    const float j0 = a;
                    const float j1 = b;
                    const float j2 = l;
                    pi0 += j0 * ii;  pi1 += j1 * ii;  pi2 += j2 * ii;
                    pt0 += j0 * tt;  pt1 += j1 * tt;  pt2 += j2 * tt;
                    pj0 += j0;  pj1 += j1;  pj2 += j2;
                }
            }

            t_m0_0 += m0_0;  t_m1_0 += m1_0;  t_m2_0 += m2_0;  t_m3_0 += m3_0;  t_m4_0 += m4_0;  t_m5_0 += m5_0;
            t_pi0 += pi0;  t_pi1 += pi1;  t_pi2 += pi2;  t_pt0 += pt0;  t_pt1 += pt1;  t_pt2 += pt2;  t_pj0 += pj0;  t_pj1 += pj1;  t_pj2 += pj2;
        }

        int n = 0;
        H[n++] += t_m0_0;  H[n++] += t_m1_0;  H[n++] += t_m2_0;
        H[n++] += t_m3_0;  H[n++] += t_m4_0;
        H[n++] += t_m5_0;
        VI[0] += t_pi0;  VI[1] += t_pi1;  VI[2] += t_pi2;
        VT[0] += t_pt0;  VT[1] += t_pt1;  VT[2] += t_pt2;
        VJ[0] += t_pj0;  VJ[1] += t_pj1;  VJ[2] += t_pj2;
    }
};

// ---- euclidean: K=3 L=1 P=3, 6 Gram sums (6 live) + 9 projection sums ----
struct GNEuclidean {
    enum { P = 3 };
    float r00, r01, r10, r11;   // A^-T of the current warp
    float muI, muT;             // masked means of warped image and template
    float h0, h1;
    double H[6], VI[3], VT[3], VJ[3];
    GNEuclidean() { std::fill(H, H + 6, 0.0); std::fill(VI, VI + 3, 0.0); std::fill(VT, VT + 3, 0.0); std::fill(VJ, VJ + 3, 0.0); }
    void add(const GNEuclidean& o) {
        for (int i = 0; i < 6; ++i) H[i] += o.H[i];
        for (int i = 0; i < 3; ++i) { VI[i] += o.VI[i]; VT[i] += o.VT[i]; VJ[i] += o.VJ[i]; }
    }

    void rows(const Mat& gx, const Mat& gy, const Mat& im, const Mat& tm,
              const Mat& lp, const Mat& mask, int y0, int y1, int base) {
        const int w = gx.cols;
        (void)lp;
        double t_m0_0 = 0, t_m1_0 = 0, t_m2_0 = 0, t_m3_0 = 0, t_m4_0 = 0, t_m5_0 = 0;
        double t_pi0 = 0, t_pi1 = 0, t_pi2 = 0, t_pt0 = 0, t_pt1 = 0, t_pt2 = 0, t_pj0 = 0, t_pj1 = 0, t_pj2 = 0;
#if FASTECC_SIMD_GN
        const int VL = VTraits<v_float32>::vlanes();
        float CV_DECL_ALIGNED(64) lane[VTraits<v_float32>::max_nlanes];
        for (int k = 0; k < VL; ++k) lane[k] = (float)k;
        const v_float32 vlane = vx_load_aligned(lane), vVL = vx_setall_f32((float)VL);
        const v_float32 vmuI = vx_setall_f32(muI), vmuT = vx_setall_f32(muT);
        const v_int32 vzi = vx_setzero_s32();
        const v_float32 vr00 = vx_setall_f32(r00), vr01 = vx_setall_f32(r01), vr10 = vx_setall_f32(r10), vr11 = vx_setall_f32(r11);
        const v_float32 vh0 = vx_setall_f32(h0), vh1 = vx_setall_f32(h1);
#endif

        for (int y = y0; y < y1; ++y) {
            const float* pgx = gx.ptr<float>(y - base);
            const float* pgy = gy.ptr<float>(y - base);
            const float* pim = im.ptr<float>(y - base);
            const float* ptm = tm.ptr<float>(y);
            const uchar* pmk = mask.ptr<uchar>(y - base);
            const float fy = (float)y;
            float m0_0 = 0, m1_0 = 0, m2_0 = 0, m3_0 = 0, m4_0 = 0, m5_0 = 0;
            float pi0 = 0, pi1 = 0, pi2 = 0, pt0 = 0, pt1 = 0, pt2 = 0, pj0 = 0, pj1 = 0, pj2 = 0;
            int x = 0;
#if FASTECC_SIMD_GN
            {
                const v_float32 vnfyh0 = vx_setall_f32(-(fy * h0)), vfyh1 = vx_setall_f32(fy * h1);
                v_float32 vm0_0 = vx_setzero_f32(), vm1_0 = vx_setzero_f32(), vm2_0 = vx_setzero_f32(), vm3_0 = vx_setzero_f32(), vm4_0 = vx_setzero_f32(), vm5_0 = vx_setzero_f32();
                v_float32 vpi0 = vx_setzero_f32(), vpi1 = vx_setzero_f32(), vpi2 = vx_setzero_f32(), vpt0 = vx_setzero_f32(), vpt1 = vx_setzero_f32(), vpt2 = vx_setzero_f32();
                v_float32 vpj0 = vx_setzero_f32(), vpj1 = vx_setzero_f32(), vpj2 = vx_setzero_f32();
                v_float32 vx = vlane;
                for (; x + VL <= w; x += VL) {
                    const v_float32 mf = v_reinterpret_as_f32(v_ne(v_reinterpret_as_s32(vx_load_expand_q(pmk + x)), vzi));
                    const v_float32 gxv = v_and(vx_load(pgx + x), mf), gyv = v_and(vx_load(pgy + x), mf);
                    const v_float32 a = v_add(v_mul(vr00, gxv), v_mul(vr01, gyv));
                    const v_float32 b = v_add(v_mul(vr10, gxv), v_mul(vr11, gyv));
                    const v_float32 hatX = v_sub(vnfyh0, v_mul(vx, vh1));
                    const v_float32 hatY = v_sub(v_mul(vx, vh0), vfyh1);
                    const v_float32 r = v_add(v_mul(a, hatX), v_mul(b, hatY));
                    const v_float32 uu0 = v_mul(r, r), uu1 = v_mul(r, a), uu2 = v_mul(r, b), uu3 = v_mul(a, a), uu4 = v_mul(a, b), uu5 = v_mul(b, b);
                    vm0_0 = v_add(vm0_0, uu0);
                    vm1_0 = v_add(vm1_0, uu1);
                    vm2_0 = v_add(vm2_0, uu2);
                    vm3_0 = v_add(vm3_0, uu3);
                    vm4_0 = v_add(vm4_0, uu4);
                    vm5_0 = v_add(vm5_0, uu5);
                    const v_float32 ii = v_sub(vx_load(pim + x), vmuI), tt = v_sub(vx_load(ptm + x), vmuT);
                    const v_float32 j0 = r;
                    const v_float32 j1 = a;
                    const v_float32 j2 = b;
                    vpi0 = v_fma(j0, ii, vpi0);  vpi1 = v_fma(j1, ii, vpi1);  vpi2 = v_fma(j2, ii, vpi2);
                    vpt0 = v_fma(j0, tt, vpt0);  vpt1 = v_fma(j1, tt, vpt1);  vpt2 = v_fma(j2, tt, vpt2);
                    vpj0 = v_add(vpj0, j0);  vpj1 = v_add(vpj1, j1);  vpj2 = v_add(vpj2, j2);
                    vx = v_add(vx, vVL);
                }
                m0_0 = v_reduce_sum(vm0_0);  m1_0 = v_reduce_sum(vm1_0);  m2_0 = v_reduce_sum(vm2_0);  m3_0 = v_reduce_sum(vm3_0);  m4_0 = v_reduce_sum(vm4_0);  m5_0 = v_reduce_sum(vm5_0);
                pi0 = v_reduce_sum(vpi0);  pi1 = v_reduce_sum(vpi1);  pi2 = v_reduce_sum(vpi2);  pt0 = v_reduce_sum(vpt0);  pt1 = v_reduce_sum(vpt1);  pt2 = v_reduce_sum(vpt2);
                pj0 = v_reduce_sum(vpj0);  pj1 = v_reduce_sum(vpj1);  pj2 = v_reduce_sum(vpj2);
            }
#endif
            // hatX, hatY are affine in (x, y): step them along the row
            float hatX = -((float)x * h1) - (fy * h0);
            float hatY =  ((float)x * h0) - (fy * h1);

            for (; x < w; ++x) {
                if (pmk[x] != 0) {
                    const float a = r00 * pgx[x] + r01 * pgy[x];
                    const float b = r10 * pgx[x] + r11 * pgy[x];
                    const float r = a * hatX + b * hatY;
                    const float uu0 = r * r, uu1 = r * a, uu2 = r * b, uu3 = a * a, uu4 = a * b, uu5 = b * b;
                    m0_0 += uu0;
                    m1_0 += uu1;
                    m2_0 += uu2;
                    m3_0 += uu3;
                    m4_0 += uu4;
                    m5_0 += uu5;
                    const float ii = pim[x] - muI, tt = ptm[x] - muT;
                    const float j0 = r;
                    const float j1 = a;
                    const float j2 = b;
                    pi0 += j0 * ii;  pi1 += j1 * ii;  pi2 += j2 * ii;
                    pt0 += j0 * tt;  pt1 += j1 * tt;  pt2 += j2 * tt;
                    pj0 += j0;  pj1 += j1;  pj2 += j2;
                }
                hatX -= h1;  hatY += h0;
            }

            t_m0_0 += m0_0;  t_m1_0 += m1_0;  t_m2_0 += m2_0;  t_m3_0 += m3_0;  t_m4_0 += m4_0;  t_m5_0 += m5_0;
            t_pi0 += pi0;  t_pi1 += pi1;  t_pi2 += pi2;  t_pt0 += pt0;  t_pt1 += pt1;  t_pt2 += pt2;  t_pj0 += pj0;  t_pj1 += pj1;  t_pj2 += pj2;
        }

        int n = 0;
        H[n++] += t_m0_0;  H[n++] += t_m1_0;  H[n++] += t_m2_0;
        H[n++] += t_m3_0;  H[n++] += t_m4_0;
        H[n++] += t_m5_0;
        VI[0] += t_pi0;  VI[1] += t_pi1;  VI[2] += t_pi2;
        VT[0] += t_pt0;  VT[1] += t_pt1;  VT[2] += t_pt2;
        VJ[0] += t_pj0;  VJ[1] += t_pj1;  VJ[2] += t_pj2;
    }
};

// ---- euclideanl: K=4 L=1 P=4, 10 Gram sums (10 live) + 12 projection sums ----
struct GNEuclideanL {
    enum { P = 4 };
    float r00, r01, r10, r11;   // A^-T of the current warp
    float muI, muT;             // masked means of warped image and template
    float h0, h1;
    float lsc;                  // scale of the laplacian column (the pre-filter sigma)
    double H[10], VI[4], VT[4], VJ[4];
    GNEuclideanL() { std::fill(H, H + 10, 0.0); std::fill(VI, VI + 4, 0.0); std::fill(VT, VT + 4, 0.0); std::fill(VJ, VJ + 4, 0.0); }
    void add(const GNEuclideanL& o) {
        for (int i = 0; i < 10; ++i) H[i] += o.H[i];
        for (int i = 0; i < 4; ++i) { VI[i] += o.VI[i]; VT[i] += o.VT[i]; VJ[i] += o.VJ[i]; }
    }

    void rows(const Mat& gx, const Mat& gy, const Mat& im, const Mat& tm,
              const Mat& lp, const Mat& mask, int y0, int y1, int base) {
        const int w = gx.cols;
        double t_m0_0 = 0, t_m1_0 = 0, t_m2_0 = 0, t_m3_0 = 0, t_m4_0 = 0, t_m5_0 = 0, t_m6_0 = 0, t_m7_0 = 0, t_m8_0 = 0, t_m9_0 = 0;
