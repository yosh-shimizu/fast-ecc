            float m0_0 = 0, m0_2 = 0, m0_5 = 0, m1_0 = 0, m1_2 = 0, m1_5 = 0, m2_0 = 0, m2_2 = 0, m2_5 = 0, m3_0 = 0, m3_2 = 0, m3_5 = 0, m4_0 = 0, m4_2 = 0, m4_5 = 0, m5_0 = 0, m5_2 = 0, m5_5 = 0;
            float pi0 = 0, pi1 = 0, pi2 = 0, pi6 = 0, pi7 = 0, pie2 = 0, pt0 = 0, pt1 = 0, pt2 = 0, pt6 = 0, pt7 = 0, pte2 = 0, pj0 = 0, pj1 = 0, pj2 = 0, pj6 = 0, pj7 = 0, pje2 = 0;
            int x = 0;
#if FASTECC_SIMD_GN
            {
                const v_float32 vfy = vx_setall_f32(fy);
                const v_float32 vfyh3 = vx_setall_f32(fy * h3), vfyh4 = vx_setall_f32(fy * h4), vfyh5 = vx_setall_f32(fy * h5);
                v_float32 vm0_0 = vx_setzero_f32(), vm0_2 = vx_setzero_f32(), vm0_5 = vx_setzero_f32(), vm1_0 = vx_setzero_f32(), vm1_2 = vx_setzero_f32(), vm1_5 = vx_setzero_f32();
                v_float32 vm2_0 = vx_setzero_f32(), vm2_2 = vx_setzero_f32(), vm2_5 = vx_setzero_f32(), vm3_0 = vx_setzero_f32(), vm3_2 = vx_setzero_f32(), vm3_5 = vx_setzero_f32();
                v_float32 vm4_0 = vx_setzero_f32(), vm4_2 = vx_setzero_f32(), vm4_5 = vx_setzero_f32(), vm5_0 = vx_setzero_f32(), vm5_2 = vx_setzero_f32(), vm5_5 = vx_setzero_f32();
