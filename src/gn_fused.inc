        const v_float32 vr00 = vx_setall_f32(r00), vr01 = vx_setall_f32(r01), vr10 = vx_setall_f32(r10), vr11 = vx_setall_f32(r11);
        const v_float32 vh2 = vx_setall_f32(h2), vh6 = vx_setall_f32(h6), vh7 = vx_setall_f32(h7);
        const v_float32 vnh0 = vx_setall_f32(-h0), vnh1 = vx_setall_f32(-h1);
