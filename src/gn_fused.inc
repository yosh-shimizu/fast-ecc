                pj0 = v_reduce_sum(vpj0);  pj1 = v_reduce_sum(vpj1);  pj2 = v_reduce_sum(vpj2);  pj6 = v_reduce_sum(vpj6);  pj7 = v_reduce_sum(vpj7);  pje2 = v_reduce_sum(vpje2);
