            int x = 0;
#if FASTECC_SIMD_GN
            {
                const v_float32 vfy = vx_setall_f32(fy);
                const v_float32 vfyh3 = vx_setall_f32(fy * h3), vfyh4 = vx_setall_f32(fy * h4), vfyh5 = vx_setall_f32(fy * h5);
                v_float32 vm0_0 = vx_setzero_f32(), vm0_2 = vx_setzero_f32(), vm0_5 = vx_setzero_f32(), vm1_0 = vx_setzero_f32(), vm1_2 = vx_setzero_f32(), vm1_5 = vx_setzero_f32();
                v_float32 vm2_0 = vx_setzero_f32(), vm2_2 = vx_setzero_f32(), vm2_5 = vx_setzero_f32(), vm3_2 = vx_setzero_f32(), vm3_5 = vx_setzero_f32(), vm4_0 = vx_setzero_f32();
                v_float32 vm4_2 = vx_setzero_f32(), vm4_5 = vx_setzero_f32(), vm5_0 = vx_setzero_f32(), vm5_2 = vx_setzero_f32(), vm5_5 = vx_setzero_f32(), vm6_2 = vx_setzero_f32();
                v_float32 vm6_5 = vx_setzero_f32(), vm7_0 = vx_setzero_f32(), vm7_2 = vx_setzero_f32(), vm7_5 = vx_setzero_f32(), vm8_2 = vx_setzero_f32(), vm8_5 = vx_setzero_f32();
                v_float32 vm9_5 = vx_setzero_f32();
                v_float32 vpi0 = vx_setzero_f32(), vpi1 = vx_setzero_f32(), vpi2 = vx_setzero_f32(), vpi6 = vx_setzero_f32(), vpi7 = vx_setzero_f32(), vpi8 = vx_setzero_f32();
                v_float32 vpie2 = vx_setzero_f32(), vpt0 = vx_setzero_f32(), vpt1 = vx_setzero_f32(), vpt2 = vx_setzero_f32(), vpt6 = vx_setzero_f32(), vpt7 = vx_setzero_f32();
                v_float32 vpt8 = vx_setzero_f32(), vpte2 = vx_setzero_f32(), vpj0 = vx_setzero_f32(), vpj1 = vx_setzero_f32(), vpj2 = vx_setzero_f32(), vpj6 = vx_setzero_f32();
                v_float32 vpj7 = vx_setzero_f32(), vpj8 = vx_setzero_f32(), vpje2 = vx_setzero_f32();
                v_float32 vx = vlane;
                for (; x + VL <= w; x += VL) {
                    const v_float32 mf = v_reinterpret_as_f32(v_ne(v_reinterpret_as_s32(vx_load_expand_q(pmk + x)), vzi));
                    const v_float32 gxv = v_and(vx_load(pgx + x), mf), gyv = v_and(vx_load(pgy + x), mf);
                    const v_float32 lv = v_and(vx_load(pl + x), mf);
                    const v_float32 gxr = v_add(v_mul(vr00, gxv), v_mul(vr01, gyv));
                    const v_float32 gyr = v_add(v_mul(vr10, gxv), v_mul(vr11, gyv));
                    const v_float32 den = v_add(v_add(v_mul(vx, vh2), vfyh5), vone);
                    const v_float32 inv = v_select(v_ne(den, vzf), v_div(vone, den), vzf);
                    const v_float32 a = v_mul(gxr, inv);
                    const v_float32 b = v_mul(gyr, inv);
                    const v_float32 hatX = v_mul(v_sub(v_sub(v_mul(vx, vnh0), vfyh3), vh6), inv);
                    const v_float32 hatY = v_mul(v_sub(v_sub(v_mul(vx, vnh1), vfyh4), vh7), inv);
                    const v_float32 e = v_add(v_mul(hatX, a), v_mul(hatY, b));
                    const v_float32 l = v_mul(vlsc, lv);
                    const v_float32 uu0 = v_mul(a, a), uu1 = v_mul(a, b), uu2 = v_mul(a, e), uu3 = v_mul(a, l), uu4 = v_mul(b, b), uu5 = v_mul(b, e), uu6 = v_mul(b, l), uu7 = v_mul(e, e), uu8 = v_mul(e, l), uu9 = v_mul(l, l);
                    const v_float32 ww0 = v_mul(vx, vx), ww2 = vx;
                    vm0_0 = v_fma(uu0, ww0, vm0_0);  vm0_2 = v_fma(uu0, ww2, vm0_2);  vm0_5 = v_add(vm0_5, uu0);
                    vm1_0 = v_fma(uu1, ww0, vm1_0);  vm1_2 = v_fma(uu1, ww2, vm1_2);  vm1_5 = v_add(vm1_5, uu1);
                    vm2_0 = v_fma(uu2, ww0, vm2_0);  vm2_2 = v_fma(uu2, ww2, vm2_2);  vm2_5 = v_add(vm2_5, uu2);
                    vm3_2 = v_fma(uu3, ww2, vm3_2);  vm3_5 = v_add(vm3_5, uu3);
                    vm4_0 = v_fma(uu4, ww0, vm4_0);  vm4_2 = v_fma(uu4, ww2, vm4_2);  vm4_5 = v_add(vm4_5, uu4);
                    vm5_0 = v_fma(uu5, ww0, vm5_0);  vm5_2 = v_fma(uu5, ww2, vm5_2);  vm5_5 = v_add(vm5_5, uu5);
                    vm6_2 = v_fma(uu6, ww2, vm6_2);  vm6_5 = v_add(vm6_5, uu6);
                    vm7_0 = v_fma(uu7, ww0, vm7_0);  vm7_2 = v_fma(uu7, ww2, vm7_2);  vm7_5 = v_add(vm7_5, uu7);
                    vm8_2 = v_fma(uu8, ww2, vm8_2);  vm8_5 = v_add(vm8_5, uu8);
                    vm9_5 = v_add(vm9_5, uu9);
                    const v_float32 ii = v_sub(vx_load(pim + x), vmuI), tt = v_sub(vx_load(ptm + x), vmuT);
                    const v_float32 j0 = v_mul(a, vx);
                    const v_float32 j1 = v_mul(b, vx);
                    const v_float32 j2 = v_mul(e, vx);
                    const v_float32 j6 = a;
                    const v_float32 j7 = b;
                    const v_float32 j8 = l;
                    vpi0 = v_fma(j0, ii, vpi0);  vpi1 = v_fma(j1, ii, vpi1);  vpi2 = v_fma(j2, ii, vpi2);  vpi6 = v_fma(j6, ii, vpi6);  vpi7 = v_fma(j7, ii, vpi7);  vpi8 = v_fma(j8, ii, vpi8);  vpie2 = v_fma(e, ii, vpie2);
                    vpt0 = v_fma(j0, tt, vpt0);  vpt1 = v_fma(j1, tt, vpt1);  vpt2 = v_fma(j2, tt, vpt2);  vpt6 = v_fma(j6, tt, vpt6);  vpt7 = v_fma(j7, tt, vpt7);  vpt8 = v_fma(j8, tt, vpt8);  vpte2 = v_fma(e, tt, vpte2);
                    vpj0 = v_add(vpj0, j0);  vpj1 = v_add(vpj1, j1);  vpj2 = v_add(vpj2, j2);  vpj6 = v_add(vpj6, j6);  vpj7 = v_add(vpj7, j7);  vpj8 = v_add(vpj8, j8);  vpje2 = v_add(vpje2, e);
                    vx = v_add(vx, vVL);
                }
                m0_0 = v_reduce_sum(vm0_0);  m0_2 = v_reduce_sum(vm0_2);  m0_5 = v_reduce_sum(vm0_5);  m1_0 = v_reduce_sum(vm1_0);  m1_2 = v_reduce_sum(vm1_2);  m1_5 = v_reduce_sum(vm1_5);
                m2_0 = v_reduce_sum(vm2_0);  m2_2 = v_reduce_sum(vm2_2);  m2_5 = v_reduce_sum(vm2_5);  m3_2 = v_reduce_sum(vm3_2);  m3_5 = v_reduce_sum(vm3_5);  m4_0 = v_reduce_sum(vm4_0);
                m4_2 = v_reduce_sum(vm4_2);  m4_5 = v_reduce_sum(vm4_5);  m5_0 = v_reduce_sum(vm5_0);  m5_2 = v_reduce_sum(vm5_2);  m5_5 = v_reduce_sum(vm5_5);  m6_2 = v_reduce_sum(vm6_2);
                m6_5 = v_reduce_sum(vm6_5);  m7_0 = v_reduce_sum(vm7_0);  m7_2 = v_reduce_sum(vm7_2);  m7_5 = v_reduce_sum(vm7_5);  m8_2 = v_reduce_sum(vm8_2);  m8_5 = v_reduce_sum(vm8_5);
                m9_5 = v_reduce_sum(vm9_5);
                pi0 = v_reduce_sum(vpi0);  pi1 = v_reduce_sum(vpi1);  pi2 = v_reduce_sum(vpi2);  pi6 = v_reduce_sum(vpi6);  pi7 = v_reduce_sum(vpi7);  pi8 = v_reduce_sum(vpi8);
                pie2 = v_reduce_sum(vpie2);  pt0 = v_reduce_sum(vpt0);  pt1 = v_reduce_sum(vpt1);  pt2 = v_reduce_sum(vpt2);  pt6 = v_reduce_sum(vpt6);  pt7 = v_reduce_sum(vpt7);
                pt8 = v_reduce_sum(vpt8);  pte2 = v_reduce_sum(vpte2);  pj0 = v_reduce_sum(vpj0);  pj1 = v_reduce_sum(vpj1);  pj2 = v_reduce_sum(vpj2);  pj6 = v_reduce_sum(vpj6);
                pj7 = v_reduce_sum(vpj7);  pj8 = v_reduce_sum(vpj8);  pje2 = v_reduce_sum(vpje2);
            }
#endif

            for (; x < w; ++x) {
                if (pmk[x] != 0) {
                    const float fx = (float)x;
                    const float gxv = r00 * pgx[x] + r01 * pgy[x];
                    const float gyv = r10 * pgx[x] + r11 * pgy[x];
                    const float den = fx * h2 + fy * h5 + 1.f;
                    // cv::divide yields 0 where the denominator is 0; match that
                    const float inv = den != 0.f ? 1.f / den : 0.f;
                    const float a = gxv * inv;
                    const float b = gyv * inv;
                    const float hatX = (-fx * h0 - fy * h3 - h6) * inv;
                    const float hatY = (-fx * h1 - fy * h4 - h7) * inv;
                    const float e = hatX * a + hatY * b;
                    const float l = lsc * pl[x];
                    const float uu0 = a * a, uu1 = a * b, uu2 = a * e, uu3 = a * l, uu4 = b * b, uu5 = b * e, uu6 = b * l, uu7 = e * e, uu8 = e * l, uu9 = l * l;
                    const float ww0 = fx * fx, ww2 = fx;
                    m0_0 += uu0 * ww0;  m0_2 += uu0 * ww2;  m0_5 += uu0;
                    m1_0 += uu1 * ww0;  m1_2 += uu1 * ww2;  m1_5 += uu1;
                    m2_0 += uu2 * ww0;  m2_2 += uu2 * ww2;  m2_5 += uu2;
                    m3_2 += uu3 * ww2;  m3_5 += uu3;
                    m4_0 += uu4 * ww0;  m4_2 += uu4 * ww2;  m4_5 += uu4;
                    m5_0 += uu5 * ww0;  m5_2 += uu5 * ww2;  m5_5 += uu5;
                    m6_2 += uu6 * ww2;  m6_5 += uu6;
                    m7_0 += uu7 * ww0;  m7_2 += uu7 * ww2;  m7_5 += uu7;
                    m8_2 += uu8 * ww2;  m8_5 += uu8;
                    m9_5 += uu9;
                    const float ii = pim[x] - muI, tt = ptm[x] - muT;
                    const float j0 = a * fx;
                    const float j1 = b * fx;
                    const float j2 = e * fx;
                    const float j6 = a;
                    const float j7 = b;
                    const float j8 = l;
                    pi0 += j0 * ii;  pi1 += j1 * ii;  pi2 += j2 * ii;  pi6 += j6 * ii;  pi7 += j7 * ii;  pi8 += j8 * ii;  pie2 += e * ii;
                    pt0 += j0 * tt;  pt1 += j1 * tt;  pt2 += j2 * tt;  pt6 += j6 * tt;  pt7 += j7 * tt;  pt8 += j8 * tt;  pte2 += e * tt;
                    pj0 += j0;  pj1 += j1;  pj2 += j2;  pj6 += j6;  pj7 += j7;  pj8 += j8;  pje2 += e;
                }
            }

            const double dy = (double)fy, dyy = (double)fy * (double)fy;
            t_m0_0 += m0_0;  t_m0_1 += m0_2 * dy;  t_m0_2 += m0_2;  t_m0_3 += m0_5 * dyy;  t_m0_4 += m0_5 * dy;  t_m0_5 += m0_5;
            t_m1_0 += m1_0;  t_m1_1 += m1_2 * dy;  t_m1_2 += m1_2;  t_m1_3 += m1_5 * dyy;  t_m1_4 += m1_5 * dy;  t_m1_5 += m1_5;
            t_m2_0 += m2_0;  t_m2_1 += m2_2 * dy;  t_m2_2 += m2_2;  t_m2_3 += m2_5 * dyy;  t_m2_4 += m2_5 * dy;
            t_m3_2 += m3_2;  t_m3_4 += m3_5 * dy;  t_m3_5 += m3_5;
            t_m4_0 += m4_0;  t_m4_1 += m4_2 * dy;  t_m4_2 += m4_2;  t_m4_3 += m4_5 * dyy;  t_m4_4 += m4_5 * dy;  t_m4_5 += m4_5;
            t_m5_0 += m5_0;  t_m5_1 += m5_2 * dy;  t_m5_2 += m5_2;  t_m5_3 += m5_5 * dyy;  t_m5_4 += m5_5 * dy;
            t_m6_2 += m6_2;  t_m6_4 += m6_5 * dy;  t_m6_5 += m6_5;
            t_m7_0 += m7_0;  t_m7_1 += m7_2 * dy;  t_m7_3 += m7_5 * dyy;
            t_m8_2 += m8_2;  t_m8_4 += m8_5 * dy;
            t_m9_5 += m9_5;
            t_pi0 += pi0;  t_pi1 += pi1;  t_pi2 += pi2;  t_pi3 += pi6 * dy;  t_pi4 += pi7 * dy;  t_pi5 += pie2 * dy;  t_pi6 += pi6;  t_pi7 += pi7;  t_pi8 += pi8;
            t_pt0 += pt0;  t_pt1 += pt1;  t_pt2 += pt2;  t_pt3 += pt6 * dy;  t_pt4 += pt7 * dy;  t_pt5 += pte2 * dy;  t_pt6 += pt6;  t_pt7 += pt7;  t_pt8 += pt8;
            t_pj0 += pj0;  t_pj1 += pj1;  t_pj2 += pj2;  t_pj3 += pj6 * dy;  t_pj4 += pj7 * dy;  t_pj5 += pje2 * dy;  t_pj6 += pj6;  t_pj7 += pj7;  t_pj8 += pj8;
        }

        int n = 0;
        H[n++] += t_m0_0;  H[n++] += t_m1_0;  H[n++] += t_m2_0;  H[n++] += t_m0_1;  H[n++] += t_m1_1;  H[n++] += t_m2_1;  H[n++] += t_m0_2;  H[n++] += t_m1_2;  H[n++] += t_m3_2;
        H[n++] += t_m4_0;  H[n++] += t_m5_0;  H[n++] += t_m1_1;  H[n++] += t_m4_1;  H[n++] += t_m5_1;  H[n++] += t_m1_2;  H[n++] += t_m4_2;  H[n++] += t_m6_2;
        H[n++] += t_m7_0;  H[n++] += t_m2_1;  H[n++] += t_m5_1;  H[n++] += t_m7_1;  H[n++] += t_m2_2;  H[n++] += t_m5_2;  H[n++] += t_m8_2;
        H[n++] += t_m0_3;  H[n++] += t_m1_3;  H[n++] += t_m2_3;  H[n++] += t_m0_4;  H[n++] += t_m1_4;  H[n++] += t_m3_4;
        H[n++] += t_m4_3;  H[n++] += t_m5_3;  H[n++] += t_m1_4;  H[n++] += t_m4_4;  H[n++] += t_m6_4;
        H[n++] += t_m7_3;  H[n++] += t_m2_4;  H[n++] += t_m5_4;  H[n++] += t_m8_4;
        H[n++] += t_m0_5;  H[n++] += t_m1_5;  H[n++] += t_m3_5;
        H[n++] += t_m4_5;  H[n++] += t_m6_5;
        H[n++] += t_m9_5;
        VI[0] += t_pi0;  VI[1] += t_pi1;  VI[2] += t_pi2;  VI[3] += t_pi3;  VI[4] += t_pi4;  VI[5] += t_pi5;  VI[6] += t_pi6;  VI[7] += t_pi7;  VI[8] += t_pi8;
        VT[0] += t_pt0;  VT[1] += t_pt1;  VT[2] += t_pt2;  VT[3] += t_pt3;  VT[4] += t_pt4;  VT[5] += t_pt5;  VT[6] += t_pt6;  VT[7] += t_pt7;  VT[8] += t_pt8;
        VJ[0] += t_pj0;  VJ[1] += t_pj1;  VJ[2] += t_pj2;  VJ[3] += t_pj3;  VJ[4] += t_pj4;  VJ[5] += t_pj5;  VJ[6] += t_pj6;  VJ[7] += t_pj7;  VJ[8] += t_pj8;
    }
};

// --- drivers --------------------------------------------------------------

template <class Acc>
void storeSystem(const Acc& s, Mat& hessian, Mat& imageProjection, Mat& templateProjection);

template <class Acc>
class GNBody : public ParallelLoopBody {
public:
    GNBody(const Acc& proto, const Mat& gx, const Mat& gy, const Mat& im, const Mat& tm,
           const Mat& lp, const Mat& mask, std::vector<Acc>& out, Mutex& m)
        : proto_(proto), gx_(gx), gy_(gy), im_(im), tm_(tm), lp_(lp), mask_(mask), out_(out), mtx_(m) {}
    void operator()(const Range& r) const CV_OVERRIDE {
        Acc s = proto_;                      // carries the warp coefficients and the means
        s.rows(gx_, gy_, im_, tm_, lp_, mask_, r.start, r.end, 0);
        AutoLock lk(mtx_);
        out_.push_back(s);
    }
private:
    Acc proto_;
    const Mat &gx_, &gy_, &im_, &tm_, &lp_, &mask_;
    std::vector<Acc>& out_;
    Mutex& mtx_;
};

// (storeSystem below)
// Full-plane driver (the multi-pass path).  lp is the laplacian plane; the
// plain kernels ignore it (pass an empty Mat).
template <class Acc>
void runFusedGN(const Acc& proto, const Mat& gx, const Mat& gy, const Mat& im, const Mat& tm,
                const Mat& lp, const Mat& mask,
                Mat& hessian, Mat& imageProjection, Mat& templateProjection) {
    std::vector<Acc> parts;
    Mutex m;
    GNBody<Acc> body(proto, gx, gy, im, tm, lp, mask, parts, m);
    parallel_for_(Range(0, gx.rows), body);

    Acc s = proto;
    std::fill(s.H, s.H + Acc::P * (Acc::P + 1) / 2, 0.0);
    std::fill(s.VI, s.VI + Acc::P, 0.0);
    std::fill(s.VT, s.VT + Acc::P, 0.0);
    std::fill(s.VJ, s.VJ + Acc::P, 0.0);
    for (size_t i = 0; i < parts.size(); ++i) s.add(parts[i]);
    storeSystem(s, hessian, imageProjection, templateProjection);
}

// Write a reduced accumulator into the (P x P) hessian and the two projections.
template <class Acc>
void storeSystem(const Acc& s, Mat& hessian, Mat& imageProjection, Mat& templateProjection) {
    const bool f64 = hessian.type() == CV_64F;
    int n = 0;
    for (int p = 0; p < Acc::P; ++p)
        for (int q = p; q < Acc::P; ++q, ++n) {
            if (f64) { hessian.at<double>(p, q) = s.H[n]; hessian.at<double>(q, p) = s.H[n]; }
            else     { hessian.at<float>(p, q) = (float)s.H[n];
                       hessian.at<float>(q, p) = (float)s.H[n]; }
        }
    for (int p = 0; p < Acc::P; ++p) {
        if (f64) { imageProjection.at<double>(p, 0) = s.VI[p];
                   templateProjection.at<double>(p, 0) = s.VT[p]; }
        else     { imageProjection.at<float>(p, 0) = (float)s.VI[p];
                   templateProjection.at<float>(p, 0) = (float)s.VT[p]; }
    }
}
