                    const float ww0 = fx * fx, ww2 = fx;
                    m0_0 += uu0 * ww0;  m0_2 += uu0 * ww2;  m0_5 += uu0;
                    m1_0 += uu1 * ww0;  m1_2 += uu1 * ww2;  m1_5 += uu1;
                    m2_0 += uu2 * ww0;  m2_2 += uu2 * ww2;  m2_5 += uu2;
                    const float ii = pim[x] - muI, tt = ptm[x] - muT;
                    const float j0 = a * fx;
                    const float j1 = b * fx;
                    const float j4 = a;
                    const float j5 = b;
                    pi0 += j0 * ii;  pi1 += j1 * ii;  pi4 += j4 * ii;  pi5 += j5 * ii;
                    pt0 += j0 * tt;  pt1 += j1 * tt;  pt4 += j4 * tt;  pt5 += j5 * tt;
                    pj0 += j0;  pj1 += j1;  pj4 += j4;  pj5 += j5;
                }
            }

            const double dy = (double)fy, dyy = (double)fy * (double)fy;
            t_m0_0 += m0_0;  t_m0_1 += m0_2 * dy;  t_m0_2 += m0_2;  t_m0_3 += m0_5 * dyy;  t_m0_4 += m0_5 * dy;  t_m0_5 += m0_5;
            t_m1_0 += m1_0;  t_m1_1 += m1_2 * dy;  t_m1_2 += m1_2;  t_m1_3 += m1_5 * dyy;  t_m1_4 += m1_5 * dy;  t_m1_5 += m1_5;
            t_m2_0 += m2_0;  t_m2_1 += m2_2 * dy;  t_m2_2 += m2_2;  t_m2_3 += m2_5 * dyy;  t_m2_4 += m2_5 * dy;  t_m2_5 += m2_5;
            t_pi0 += pi0;  t_pi1 += pi1;  t_pi2 += pi4 * dy;  t_pi3 += pi5 * dy;  t_pi4 += pi4;  t_pi5 += pi5;
            t_pt0 += pt0;  t_pt1 += pt1;  t_pt2 += pt4 * dy;  t_pt3 += pt5 * dy;  t_pt4 += pt4;  t_pt5 += pt5;
            t_pj0 += pj0;  t_pj1 += pj1;  t_pj2 += pj4 * dy;  t_pj3 += pj5 * dy;  t_pj4 += pj4;  t_pj5 += pj5;
        }

        int n = 0;
        H[n++] += t_m0_0;  H[n++] += t_m1_0;  H[n++] += t_m0_1;  H[n++] += t_m1_1;  H[n++] += t_m0_2;  H[n++] += t_m1_2;
        H[n++] += t_m2_0;  H[n++] += t_m1_1;  H[n++] += t_m2_1;  H[n++] += t_m1_2;  H[n++] += t_m2_2;
        H[n++] += t_m0_3;  H[n++] += t_m1_3;  H[n++] += t_m0_4;  H[n++] += t_m1_4;
        H[n++] += t_m2_3;  H[n++] += t_m1_4;  H[n++] += t_m2_4;
        H[n++] += t_m0_5;  H[n++] += t_m1_5;
        H[n++] += t_m2_5;
        VI[0] += t_pi0;  VI[1] += t_pi1;  VI[2] += t_pi2;  VI[3] += t_pi3;  VI[4] += t_pi4;  VI[5] += t_pi5;
        VT[0] += t_pt0;  VT[1] += t_pt1;  VT[2] += t_pt2;  VT[3] += t_pt3;  VT[4] += t_pt4;  VT[5] += t_pt5;
        VJ[0] += t_pj0;  VJ[1] += t_pj1;  VJ[2] += t_pj2;  VJ[3] += t_pj3;  VJ[4] += t_pj4;  VJ[5] += t_pj5;
    }
};

// ---- affinel: K=3 L=3 P=7, 25 Gram sums (14 live) + 21 projection sums ----
struct GNAffineL {
    enum { P = 7 };
    float r00, r01, r10, r11;   // A^-T of the current warp
    float muI, muT;             // masked means of warped image and template
    float lsc;                  // scale of the laplacian column (the pre-filter sigma)
    double H[28], VI[7], VT[7], VJ[7];
    GNAffineL() { std::fill(H, H + 28, 0.0); std::fill(VI, VI + 7, 0.0); std::fill(VT, VT + 7, 0.0); std::fill(VJ, VJ + 7, 0.0); }
    void add(const GNAffineL& o) {
        for (int i = 0; i < 28; ++i) H[i] += o.H[i];
        for (int i = 0; i < 7; ++i) { VI[i] += o.VI[i]; VT[i] += o.VT[i]; VJ[i] += o.VJ[i]; }
    }

    void rows(const Mat& gx, const Mat& gy, const Mat& im, const Mat& tm,
              const Mat& lp, const Mat& mask, int y0, int y1, int base) {
        const int w = gx.cols;
        double t_m0_0 = 0, t_m0_1 = 0, t_m0_2 = 0, t_m0_3 = 0, t_m0_4 = 0, t_m0_5 = 0, t_m1_0 = 0, t_m1_1 = 0, t_m1_2 = 0, t_m1_3 = 0, t_m1_4 = 0, t_m1_5 = 0, t_m2_2 = 0, t_m2_4 = 0, t_m2_5 = 0, t_m3_0 = 0, t_m3_1 = 0, t_m3_2 = 0, t_m3_3 = 0, t_m3_4 = 0, t_m3_5 = 0, t_m4_2 = 0, t_m4_4 = 0, t_m4_5 = 0, t_m5_5 = 0;
        double t_pi0 = 0, t_pi1 = 0, t_pi2 = 0, t_pi3 = 0, t_pi4 = 0, t_pi5 = 0, t_pi6 = 0, t_pt0 = 0, t_pt1 = 0, t_pt2 = 0, t_pt3 = 0, t_pt4 = 0, t_pt5 = 0, t_pt6 = 0, t_pj0 = 0, t_pj1 = 0, t_pj2 = 0, t_pj3 = 0, t_pj4 = 0, t_pj5 = 0, t_pj6 = 0;
#if FASTECC_SIMD_GN
        const int VL = VTraits<v_float32>::vlanes();
        float CV_DECL_ALIGNED(64) lane[VTraits<v_float32>::max_nlanes];
        for (int k = 0; k < VL; ++k) lane[k] = (float)k;
        const v_float32 vlane = vx_load_aligned(lane), vVL = vx_setall_f32((float)VL);
        const v_float32 vmuI = vx_setall_f32(muI), vmuT = vx_setall_f32(muT);
        const v_int32 vzi = vx_setzero_s32();
        const v_float32 vr00 = vx_setall_f32(r00), vr01 = vx_setall_f32(r01), vr10 = vx_setall_f32(r10), vr11 = vx_setall_f32(r11);
        const v_float32 vlsc = vx_setall_f32(lsc);
#endif

        for (int y = y0; y < y1; ++y) {
            const float* pgx = gx.ptr<float>(y - base);
            const float* pgy = gy.ptr<float>(y - base);
            const float* pim = im.ptr<float>(y - base);
            const float* ptm = tm.ptr<float>(y);
            const float* pl = lp.ptr<float>(y - base);
            const uchar* pmk = mask.ptr<uchar>(y - base);
            const float fy = (float)y;
            float m0_0 = 0, m0_2 = 0, m0_5 = 0, m1_0 = 0, m1_2 = 0, m1_5 = 0, m2_2 = 0, m2_5 = 0, m3_0 = 0, m3_2 = 0, m3_5 = 0, m4_2 = 0, m4_5 = 0, m5_5 = 0;
            float pi0 = 0, pi1 = 0, pi4 = 0, pi5 = 0, pi6 = 0, pt0 = 0, pt1 = 0, pt4 = 0, pt5 = 0, pt6 = 0, pj0 = 0, pj1 = 0, pj4 = 0, pj5 = 0, pj6 = 0;
            int x = 0;
#if FASTECC_SIMD_GN
            {
                const v_float32 vfy = vx_setall_f32(fy);
                v_float32 vm0_0 = vx_setzero_f32(), vm0_2 = vx_setzero_f32(), vm0_5 = vx_setzero_f32(), vm1_0 = vx_setzero_f32(), vm1_2 = vx_setzero_f32(), vm1_5 = vx_setzero_f32();
                v_float32 vm2_2 = vx_setzero_f32(), vm2_5 = vx_setzero_f32(), vm3_0 = vx_setzero_f32(), vm3_2 = vx_setzero_f32(), vm3_5 = vx_setzero_f32(), vm4_2 = vx_setzero_f32();
                v_float32 vm4_5 = vx_setzero_f32(), vm5_5 = vx_setzero_f32();
                v_float32 vpi0 = vx_setzero_f32(), vpi1 = vx_setzero_f32(), vpi4 = vx_setzero_f32(), vpi5 = vx_setzero_f32(), vpi6 = vx_setzero_f32(), vpt0 = vx_setzero_f32();
                v_float32 vpt1 = vx_setzero_f32(), vpt4 = vx_setzero_f32(), vpt5 = vx_setzero_f32(), vpt6 = vx_setzero_f32(), vpj0 = vx_setzero_f32(), vpj1 = vx_setzero_f32();
                v_float32 vpj4 = vx_setzero_f32(), vpj5 = vx_setzero_f32(), vpj6 = vx_setzero_f32();
                v_float32 vx = vlane;
                for (; x + VL <= w; x += VL) {
                    const v_float32 mf = v_reinterpret_as_f32(v_ne(v_reinterpret_as_s32(vx_load_expand_q(pmk + x)), vzi));
                    const v_float32 gxv = v_and(vx_load(pgx + x), mf), gyv = v_and(vx_load(pgy + x), mf);
                    const v_float32 lv = v_and(vx_load(pl + x), mf);
                    const v_float32 a = v_add(v_mul(vr00, gxv), v_mul(vr01, gyv));
                    const v_float32 b = v_add(v_mul(vr10, gxv), v_mul(vr11, gyv));
                    const v_float32 l = v_mul(vlsc, lv);
                    const v_float32 uu0 = v_mul(a, a), uu1 = v_mul(a, b), uu2 = v_mul(a, l), uu3 = v_mul(b, b), uu4 = v_mul(b, l), uu5 = v_mul(l, l);
                    const v_float32 ww0 = v_mul(vx, vx), ww2 = vx;
                    vm0_0 = v_fma(uu0, ww0, vm0_0);  vm0_2 = v_fma(uu0, ww2, vm0_2);  vm0_5 = v_add(vm0_5, uu0);
                    vm1_0 = v_fma(uu1, ww0, vm1_0);  vm1_2 = v_fma(uu1, ww2, vm1_2);  vm1_5 = v_add(vm1_5, uu1);
                    vm2_2 = v_fma(uu2, ww2, vm2_2);  vm2_5 = v_add(vm2_5, uu2);
                    vm3_0 = v_fma(uu3, ww0, vm3_0);  vm3_2 = v_fma(uu3, ww2, vm3_2);  vm3_5 = v_add(vm3_5, uu3);
                    vm4_2 = v_fma(uu4, ww2, vm4_2);  vm4_5 = v_add(vm4_5, uu4);
                    vm5_5 = v_add(vm5_5, uu5);
                    const v_float32 ii = v_sub(vx_load(pim + x), vmuI), tt = v_sub(vx_load(ptm + x), vmuT);
                    const v_float32 j0 = v_mul(a, vx);
                    const v_float32 j1 = v_mul(b, vx);
                    const v_float32 j4 = a;
                    const v_float32 j5 = b;
                    const v_float32 j6 = l;
                    vpi0 = v_fma(j0, ii, vpi0);  vpi1 = v_fma(j1, ii, vpi1);  vpi4 = v_fma(j4, ii, vpi4);  vpi5 = v_fma(j5, ii, vpi5);  vpi6 = v_fma(j6, ii, vpi6);
                    vpt0 = v_fma(j0, tt, vpt0);  vpt1 = v_fma(j1, tt, vpt1);  vpt4 = v_fma(j4, tt, vpt4);  vpt5 = v_fma(j5, tt, vpt5);  vpt6 = v_fma(j6, tt, vpt6);
                    vpj0 = v_add(vpj0, j0);  vpj1 = v_add(vpj1, j1);  vpj4 = v_add(vpj4, j4);  vpj5 = v_add(vpj5, j5);  vpj6 = v_add(vpj6, j6);
                    vx = v_add(vx, vVL);
                }
                m0_0 = v_reduce_sum(vm0_0);  m0_2 = v_reduce_sum(vm0_2);  m0_5 = v_reduce_sum(vm0_5);  m1_0 = v_reduce_sum(vm1_0);  m1_2 = v_reduce_sum(vm1_2);  m1_5 = v_reduce_sum(vm1_5);
                m2_2 = v_reduce_sum(vm2_2);  m2_5 = v_reduce_sum(vm2_5);  m3_0 = v_reduce_sum(vm3_0);  m3_2 = v_reduce_sum(vm3_2);  m3_5 = v_reduce_sum(vm3_5);  m4_2 = v_reduce_sum(vm4_2);
                m4_5 = v_reduce_sum(vm4_5);  m5_5 = v_reduce_sum(vm5_5);
                pi0 = v_reduce_sum(vpi0);  pi1 = v_reduce_sum(vpi1);  pi4 = v_reduce_sum(vpi4);  pi5 = v_reduce_sum(vpi5);  pi6 = v_reduce_sum(vpi6);  pt0 = v_reduce_sum(vpt0);
                pt1 = v_reduce_sum(vpt1);  pt4 = v_reduce_sum(vpt4);  pt5 = v_reduce_sum(vpt5);  pt6 = v_reduce_sum(vpt6);  pj0 = v_reduce_sum(vpj0);  pj1 = v_reduce_sum(vpj1);
                pj4 = v_reduce_sum(vpj4);  pj5 = v_reduce_sum(vpj5);  pj6 = v_reduce_sum(vpj6);
            }
#endif

            for (; x < w; ++x) {
                if (pmk[x] != 0) {
                    const float fx = (float)x;
                    const float a = r00 * pgx[x] + r01 * pgy[x];
                    const float b = r10 * pgx[x] + r11 * pgy[x];
                    const float l = lsc * pl[x];
                    const float uu0 = a * a, uu1 = a * b, uu2 = a * l, uu3 = b * b, uu4 = b * l, uu5 = l * l;
                    const float ww0 = fx * fx, ww2 = fx;
                    m0_0 += uu0 * ww0;  m0_2 += uu0 * ww2;  m0_5 += uu0;
                    m1_0 += uu1 * ww0;  m1_2 += uu1 * ww2;  m1_5 += uu1;
                    m2_2 += uu2 * ww2;  m2_5 += uu2;
                    m3_0 += uu3 * ww0;  m3_2 += uu3 * ww2;  m3_5 += uu3;
                    m4_2 += uu4 * ww2;  m4_5 += uu4;
                    m5_5 += uu5;
                    const float ii = pim[x] - muI, tt = ptm[x] - muT;
                    const float j0 = a * fx;
                    const float j1 = b * fx;
                    const float j4 = a;
                    const float j5 = b;
                    const float j6 = l;
                    pi0 += j0 * ii;  pi1 += j1 * ii;  pi4 += j4 * ii;  pi5 += j5 * ii;  pi6 += j6 * ii;
                    pt0 += j0 * tt;  pt1 += j1 * tt;  pt4 += j4 * tt;  pt5 += j5 * tt;  pt6 += j6 * tt;
                    pj0 += j0;  pj1 += j1;  pj4 += j4;  pj5 += j5;  pj6 += j6;
                }
            }

            const double dy = (double)fy, dyy = (double)fy * (double)fy;
            t_m0_0 += m0_0;  t_m0_1 += m0_2 * dy;  t_m0_2 += m0_2;  t_m0_3 += m0_5 * dyy;  t_m0_4 += m0_5 * dy;  t_m0_5 += m0_5;
            t_m1_0 += m1_0;  t_m1_1 += m1_2 * dy;  t_m1_2 += m1_2;  t_m1_3 += m1_5 * dyy;  t_m1_4 += m1_5 * dy;  t_m1_5 += m1_5;
            t_m2_2 += m2_2;  t_m2_4 += m2_5 * dy;  t_m2_5 += m2_5;
            t_m3_0 += m3_0;  t_m3_1 += m3_2 * dy;  t_m3_2 += m3_2;  t_m3_3 += m3_5 * dyy;  t_m3_4 += m3_5 * dy;  t_m3_5 += m3_5;
            t_m4_2 += m4_2;  t_m4_4 += m4_5 * dy;  t_m4_5 += m4_5;
            t_m5_5 += m5_5;
            t_pi0 += pi0;  t_pi1 += pi1;  t_pi2 += pi4 * dy;  t_pi3 += pi5 * dy;  t_pi4 += pi4;  t_pi5 += pi5;  t_pi6 += pi6;
            t_pt0 += pt0;  t_pt1 += pt1;  t_pt2 += pt4 * dy;  t_pt3 += pt5 * dy;  t_pt4 += pt4;  t_pt5 += pt5;  t_pt6 += pt6;
            t_pj0 += pj0;  t_pj1 += pj1;  t_pj2 += pj4 * dy;  t_pj3 += pj5 * dy;  t_pj4 += pj4;  t_pj5 += pj5;  t_pj6 += pj6;
        }

        int n = 0;
        H[n++] += t_m0_0;  H[n++] += t_m1_0;  H[n++] += t_m0_1;  H[n++] += t_m1_1;  H[n++] += t_m0_2;  H[n++] += t_m1_2;  H[n++] += t_m2_2;
        H[n++] += t_m3_0;  H[n++] += t_m1_1;  H[n++] += t_m3_1;  H[n++] += t_m1_2;  H[n++] += t_m3_2;  H[n++] += t_m4_2;
        H[n++] += t_m0_3;  H[n++] += t_m1_3;  H[n++] += t_m0_4;  H[n++] += t_m1_4;  H[n++] += t_m2_4;
        H[n++] += t_m3_3;  H[n++] += t_m1_4;  H[n++] += t_m3_4;  H[n++] += t_m4_4;
        H[n++] += t_m0_5;  H[n++] += t_m1_5;  H[n++] += t_m2_5;
        H[n++] += t_m3_5;  H[n++] += t_m4_5;
        H[n++] += t_m5_5;
        VI[0] += t_pi0;  VI[1] += t_pi1;  VI[2] += t_pi2;  VI[3] += t_pi3;  VI[4] += t_pi4;  VI[5] += t_pi5;  VI[6] += t_pi6;
        VT[0] += t_pt0;  VT[1] += t_pt1;  VT[2] += t_pt2;  VT[3] += t_pt3;  VT[4] += t_pt4;  VT[5] += t_pt5;  VT[6] += t_pt6;
        VJ[0] += t_pj0;  VJ[1] += t_pj1;  VJ[2] += t_pj2;  VJ[3] += t_pj3;  VJ[4] += t_pj4;  VJ[5] += t_pj5;  VJ[6] += t_pj6;
    }
};

// ---- homography: K=3 L=3 P=8, 31 Gram sums (18 live) + 24 projection sums ----
struct GNHomography {
    enum { P = 8 };
